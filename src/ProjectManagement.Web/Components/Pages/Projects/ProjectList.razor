@page "/projects"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using ProjectManagement.Web.Data
@using ProjectManagement.Web.Models
@using ProjectManagement.Web.Services
@inject IProjectService ProjectService
@inject ApplicationDbContext Db

<PageTitle>專案列表</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>專案列表</h1>
    <AuthorizeView Roles="Admin,Manager">
        <Authorized><a class="btn btn-primary" href="/projects/new">+ 新增專案</a></Authorized>
    </AuthorizeView>
</div>

<div class="row g-2 mb-3">
    <div class="col-auto">
        <select class="form-select" @bind="filterDepartmentId" @bind:after="ReloadAsync">
            <option value="">全部單位</option>
            @foreach (var d in departments)
            {
                <option value="@d.Id">@d.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <select class="form-select" @bind="filterCategoryId" @bind:after="ReloadAsync">
            <option value="">全部類別</option>
            @foreach (var c in categories)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <select class="form-select" @bind="filterStatus" @bind:after="ReloadAsync">
            <option value="">全部狀態</option>
            @foreach (var s in Enum.GetValues<ProjectStatus>())
            {
                <option value="@s">@StatusText(s)</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <select class="form-select" @bind="filterResponsibleUserId" @bind:after="ReloadAsync">
            <option value="">全部負責人</option>
            @foreach (var u in users)
            {
                <option value="@u.Id">@u.DisplayName</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <input class="form-control" placeholder="搜尋專案名稱" @bind="filterKeyword" @bind:event="oninput" @bind:after="ReloadAsync" />
    </div>
    <div class="col-auto">
        <select class="form-select" @bind="sortBy" @bind:after="ApplySort">
            <option value="created">排序：建立時間（新到舊）</option>
            <option value="score">排序：效益分數（高到低）</option>
        </select>
    </div>
</div>

@if (projects is null)
{
    <p><em>載入中…</em></p>
}
else if (projects.Count == 0)
{
    <p class="text-muted">沒有符合條件的專案。</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>專案名稱</th>
                <th>單位</th>
                <th>系統類別</th>
                <th>負責人</th>
                <th>預計期間</th>
                <th>總時數</th>
                <th>完成度</th>
                <th>分數</th>
                <th>狀態</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in projects)
            {
                <tr style="cursor:pointer" @onclick="() => NavigateToDetail(p.Id)">
                    <td>@p.Name</td>
                    <td>@(p.Department?.Name ?? "—")</td>
                    <td>@(p.SystemCategory?.Name ?? "—")</td>
                    <td>@(p.ResponsibleDisplayName ?? "未指派")</td>
                    <td>@FormatDate(p.PlannedStartDate) ～ @FormatDate(p.PlannedEndDate)</td>
                    <td>@p.TotalEstimatedHours</td>
                    <td>
                        <div class="progress" style="height:18px;min-width:100px">
                            <div class="progress-bar" style="width:@(p.CompletionPercent)%">@p.CompletionPercent %</div>
                        </div>
                    </td>
                    <td>@p.TotalScore</td>
                    <td>@StatusText(p.Status)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private List<Project>? projects;
    private List<Department> departments = [];
    private List<SystemCategory> categories = [];
    private List<ApplicationUser> users = [];

    private string filterDepartmentId = "";
    private string filterCategoryId = "";
    private string filterStatus = "";
    private string filterResponsibleUserId = "";
    private string filterKeyword = "";
    private string sortBy = "created";

    protected override async Task OnInitializedAsync()
    {
        departments = await Db.Departments.Where(d => d.IsActive).OrderBy(d => d.Name).ToListAsync();
        categories = await Db.SystemCategories.Where(c => c.IsActive).OrderBy(c => c.Name).ToListAsync();
        users = await Db.Users.Where(u => u.IsActive).OrderBy(u => u.DisplayName).ToListAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        int? deptId = int.TryParse(filterDepartmentId, out var d) ? d : null;
        int? catId = int.TryParse(filterCategoryId, out var c) ? c : null;
        ProjectStatus? status = Enum.TryParse<ProjectStatus>(filterStatus, out var s) ? s : null;
        string? responsibleUserId = string.IsNullOrWhiteSpace(filterResponsibleUserId) ? null : filterResponsibleUserId;

        projects = await ProjectService.GetListAsync(deptId, catId, status, filterKeyword, responsibleUserId);
        ApplySort();
    }

    /// <summary>TotalScore 是計算出來的欄位（不在資料庫裡），所以排序要在抓回清單之後、在記憶體裡排。</summary>
    private void ApplySort()
    {
        if (projects is null) return;
        projects = sortBy == "score"
            ? projects.OrderByDescending(p => p.TotalScore).ToList()
            : projects.OrderByDescending(p => p.CreatedAt).ToList();
    }

    private void NavigateToDetail(int id) => Nav.NavigateTo($"/projects/{id}");

    private static string FormatDate(DateTime? date) => date?.ToString("yyyy-MM-dd") ?? "—";

    private static string StatusText(ProjectStatus status) => status switch
    {
        ProjectStatus.NotStarted => "未開始",
        ProjectStatus.InProgress => "進行中",
        ProjectStatus.Completed => "已完成",
        ProjectStatus.OnHold => "暫停",
        _ => status.ToString()
    };
}
